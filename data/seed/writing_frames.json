    {"id":"f32","promptVn":"Do hậu quả của cơn bão, nhiều chuyến bay bị hủy.","frameEn":"_____ the storm, many flights were cancelled.","answer":"As a result of","function":"cause","distractors":["In terms of","In spite of","With regard to"],"hint":"Nguyên nhân"},
    {"id":"f33","promptVn":"Chúng ta nên cắt giảm nhựa dùng một lần.","frameEn":"We should _____ single-use plastic.","answer":"cut down on","function":"solution","distractors":["result in","account for","peak at"],"hint":"Giảm thiểu"},
    {"id":"f34","promptVn":"Chính phủ phải giải quyết tình trạng thất nghiệp.","frameEn":"The government must _____ rising unemployment.","answer":"deal with","function":"solution","distractors":["stem from","level off","make up"],"hint":"Xử lý vấn đề"},
    {"id":"f35","promptVn":"Nhìn chung, dự án đã thành công.","frameEn":"_____, the project was a success.","answer":"On the whole","function":"conclusion","distractors":["For instance","In contrast","Provided that"],"hint":"Đánh giá tổng thể"},
