    {"id":"f25","promptVn":"Các thành phố nên ưu tiên giao thông công cộng.","frameEn":"Cities should _____ public transport.","answer":"give priority to","function":"solution","distractors":["result in","stem from","peak at"],"hint":"Ưu tiên"},
    {"id":"f26","promptVn":"Tóm lại, cả hai lựa chọn đều có nhược điểm.","frameEn":"_____, both options have clear drawbacks.","answer":"To sum up","function":"conclusion","distractors":["For instance","In contrast","Furthermore"],"hint":"Tóm tắt"},
    {"id":"f27","promptVn":"Sau 2015, xu hướng đi ngang.","frameEn":"After 2015, the trend _____.","answer":"levelled off","function":"task1","distractors":["peaked at","halved","surpassed"],"hint":"Ổn định sau biến động"},
    {"id":"f28","promptVn":"Con số giảm một nửa từ 2000 đến 2010.","frameEn":"The figure _____ between 2000 and 2010.","answer":"halved","function":"task1","distractors":["doubled","peaked","fluctuated"],"hint":"Giảm 50%"},
    {"id":"f29","promptVn":"Xuất khẩu gấp đôi trong mười năm.","frameEn":"Exports _____ over ten years.","answer":"doubled","function":"task1","distractors":["halved","remained stable","narrowed"],"hint":"Tăng gấp đôi"},
    {"id":"f30","promptVn":"Pháp và Đức ghi lần lượt 20 và 25.","frameEn":"France and Germany scored 20 and 25 _____.","answer":"respectively","function":"task1","distractors":["overall","approximately","furthermore"],"hint":"Thứ tự tương ứng"},
