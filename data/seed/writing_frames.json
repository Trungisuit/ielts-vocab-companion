{
  "frames": [
    {"id":"f1","promptVn":"Ô nhiễm không khí chủ yếu bắt nguồn từ giao thông đông đúc.","frameEn":"Air pollution mainly _____ heavy traffic.","answer":"stems from","function":"cause","distractors":["results in","in terms of","on the other hand"],"hint":"Nêu nguyên nhân"},
    {"id":"f2","promptVn":"Chế độ ăn kém có thể dẫn đến các vấn đề sức khỏe.","frameEn":"Poor diet can _____ serious health problems.","answer":"result in","function":"cause","distractors":["stem from","in contrast","to sum up"],"hint":"Nêu kết quả"},
    {"id":"f3","promptVn":"Xét về chi phí, năng lượng mặt trời ngày càng cạnh tranh.","frameEn":"_____ cost, solar power is increasingly competitive.","answer":"In terms of","function":"opinion","distractors":["As a result of","In conclusion","On the one hand"],"hint":"Nêu khía cạnh"},
    {"id":"f4","promptVn":"Nhiều người tin rằng tập thể dục cải thiện sức khỏe tinh thần.","frameEn":"_____ exercise improves mental health.","answer":"It is widely believed that","function":"opinion","distractors":["There is no denying that","To sum up","In contrast"],"hint":"Nêu quan điểm phổ biến"},
    {"id":"f5","promptVn":"Một mặt ô tô tiện lợi; mặt khác chúng gây ô nhiễm.","frameEn":"_____, cars are convenient; _____, they pollute.","answer":"On the one hand... on the other hand","function":"contrast","distractors":["In terms of","As a result","To sum up"],"hint":"Đối lập hai mặt"},
    {"id":"f6","promptVn":"Ngược lại, vùng nông thôn có không khí sạch hơn.","frameEn":"_____, rural areas enjoy cleaner air.","answer":"By contrast","function":"contrast","distractors":["Furthermore","Consequently","In conclusion"],"hint":"So sánh đối lập"},
    {"id":"f7","promptVn":"Chính phủ phải thực hiện biện pháp để giảm khí thải.","frameEn":"Governments must _____ reduce emissions.","answer":"take measures to","function":"solution","distractors":["result in","stem from","account for"],"hint":"Đề xuất hành động"},
    {"id":"f8","promptVn":"Cha mẹ đóng vai trò then chốt trong sự phát triển của trẻ.","frameEn":"Parents _____ children's development.","answer":"play a crucial role in","function":"solution","distractors":["pose a threat to","result in","cut down on"],"hint":"Nhấn mạnh tầm quan trọng"},
    {"id":"f9","promptVn":"Tóm lại, lợi ích vượt trội so với hạn chế.","frameEn":"_____, the benefits outweigh the drawbacks.","answer":"In conclusion","function":"conclusion","distractors":["Furthermore","For instance","In contrast"],"hint":"Kết luận bài"},
    {"id":"f10","promptVn":"Về lâu dài, đầu tư giáo dục sẽ có lợi.","frameEn":"Investing in education pays off _____.","answer":"in the long run","function":"conclusion","distractors":["in terms of","on the whole","for instance"],"hint":"Nhìn dài hạn"},
    {"id":"f11","promptVn":"Có sự gia tăng đáng kể về mua sắm trực tuyến.","frameEn":"There has been _____ online shopping.","answer":"a significant increase in","function":"task1","distractors":["a dramatic fall in","remain stable","just under"],"hint":"Mô tả xu hướng tăng"},
    {"id":"f12","promptVn":"Tỷ lệ thất nghiệp duy trì ổn định từ 2015 đến 2017.","frameEn":"Unemployment _____ between 2015 and 2017.","answer":"remained stable","function":"task1","distractors":["peaked at","fluctuated wildly","halved"],"hint":"Mô tả ổn định"},
    {"id":"f13","promptVn":"Doanh số đạt đỉnh ở 5 triệu sản phẩm năm 2018.","frameEn":"Sales _____ 5 million units in 2018.","answer":"peaked at","function":"task1","distractors":["hit a low of","accounted for","levelled off"],"hint":"Mô tả đỉnh"},
    {"id":"f14","promptVn":"Ô tô chiếm 40% tất cả các chuyến đi.","frameEn":"Cars _____ 40% of all journeys.","answer":"accounted for","function":"task1","distractors":["resulted in","stemmed from","peaked at"],"hint":"Nêu tỷ lệ"},
    {"id":"f15","promptVn":"Nhìn chung, xuất khẩu tăng trong giai đoạn này.","frameEn":"_____, exports grew during the period.","answer":"Overall","function":"task1","distractors":["Nevertheless","For instance","Provided that"],"hint":"Tóm tắt biểu đồ"},
    {"id":"f16","promptVn":"Không thể phủ nhận rằng công nghệ đã thay đổi giáo dục.","frameEn":"_____ technology has changed education.","answer":"There is no denying that","function":"opinion","distractors":["In contrast","As a result of","Just under"],"hint":"Khẳng định mạnh"},
    {"id":"f17","promptVn":"Rác nhựa gây ra mối đe dọa cho sinh vật biển.","frameEn":"Plastic waste _____ marine life.","answer":"poses a threat to","function":"cause","distractors":["takes measures to","plays a role in","accounts for"],"hint":"Nêu mối nguy"},
    {"id":"f18","promptVn":"Nhiều vấn đề xã hội bắt nguồn từ nghèo đói.","frameEn":"Many social problems _____ poverty.","answer":"stem from","function":"cause","distractors":["result in","contribute to","cut down on"],"hint":"Nêu nguồn gốc"},
    {"id":"f19","promptVn":"Hơn nữa, tập thể dục còn giảm căng thẳng.","frameEn":"Exercise improves health; _____, it reduces stress.","answer":"furthermore","function":"opinion","distractors":["nevertheless","whereas","overall"],"hint":"Thêm ý"},
    {"id":"f20","promptVn":"Kế hoạch tốn kém; tuy nhiên vẫn đáng theo đuổi.","frameEn":"The plan is costly; _____, it is worth pursuing.","answer":"nevertheless","function":"contrast","distractors":["furthermore","consequently","overall"],"hint":"Nhượng bộ"},
    {"id":"f21","promptVn":"Giá nhiên liệu tăng; do đó chi phí thực phẩm tăng.","frameEn":"Fuel prices rose; _____, food costs increased.","answer":"consequently","function":"cause","distractors":["whereas","furthermore","in contrast"],"hint":"Kết quả logic"},
    {"id":"f22","promptVn":"Dân thành phố dựa vào ô tô, trong khi dân làng đi bộ.","frameEn":"City dwellers rely on cars, _____ villagers often walk.","answer":"whereas","function":"contrast","distractors":["furthermore","consequently","overall"],"hint":"Đối lập"},
    {"id":"f23","promptVn":"Công nghệ hỗ trợ việc học, miễn là dùng khôn ngoan.","frameEn":"Technology helps learning, _____ it is used wisely.","answer":"provided that","function":"solution","distractors":["in spite of","as a result of","in terms of"],"hint":"Điều kiện"},
